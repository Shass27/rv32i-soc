# =============================================================================
# VIVADO
# =============================================================================

# Generated project directories (the .xpr file is the portable entry point)
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.runs/
*.sdk/
*.srcs/sources_1/ip/
*.gen/

# Vivado log and journal files
*.log
*.jou
*.str
vivado_*.backup.log
vivado_*.backup.jou

# Bitstream and device-specific outputs — commit only if intentional
*.bit
*.bin
*.mcs
*.prm
*.ltx

# Checkpoint and implementation reports (reproducible from sources)
*.dcp
*.rpt
*.xpe
*.xsa

# HLS project output
solution*/
hls_prj/
*.ap_*

# Timing summary / utilization — can commit selectively if desired
# *.util.rpt
# *.timing.rpt


