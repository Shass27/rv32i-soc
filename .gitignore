# VERILATOR
# =============================================================================

obj_dir/
*.o
*.a
V*.mk
V*.cpp
V*.h
verilated.cpp
verilated.h
verilated_*.cpp
verilated_*.h


# =============================================================================
# RISC-V GCC TOOLCHAIN OUTPUT
# =============================================================================

# Object files and archives
*.o
*.a
*.d

# Linked ELF binaries
*.elf

# Flat binary / hex dumps for memory initialisation
*.bin
*.mem

# Map / disassembly files
*.map
*.lst
*.dis


